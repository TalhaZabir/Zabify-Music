{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "rewrites": [
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|registerSW\\.js|manifest\\.webmanifest|favicon\\.svg|.*\\.[a-zA-Z0-9]+$).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }]
    },
    {
      "source": "/(sw\\.js|registerSW\\.js|manifest\\.webmanifest|favicon\\.svg|icons/(.*)|index\\.html)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    },
    {
      "source": "/((?!api/|assets/|icons/|sw\\.js|registerSW\\.js|manifest\\.webmanifest|favicon\\.svg|.*\\.[a-zA-Z0-9]+$).*)",
      "headers": [{ "key": "Cache-Control", "value": "no-cache" }]
    }
  ]
}
