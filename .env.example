# Zabify environment — copy to .env and never commit secrets
# Frontend (VITE_ prefix is exposed to browser — no secrets here)
VITE_API_BASE_URL=http://localhost:8788/api
VITE_APP_NAME=Zabify

# Backend (server-only — never use VITE_ prefix)
PORT=8788
HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5174
LOG_LEVEL=info
CACHE_TTL_SEARCH_SEC=300
CACHE_TTL_METADATA_SEC=3600
CACHE_TTL_LYRICS_SEC=3600
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
YTMUSIC_LANG=en
YTMUSIC_COUNTRY=US
# Optional: Last.fm scrobbling proxy (get keys at https://www.last.fm/api).
# Without these, POST /api/integrations/lastfm/* returns 503 and the UI
# shows "not configured". The secret never leaves the server.
LASTFM_API_KEY=
LASTFM_API_SECRET=
# Stream resolution: Innertube decipher is tried first, then yt-dlp fallback.
# Requires Python 3 + `pip install yt-dlp` on the API host.
YTDLP_ENABLED=true
PYTHON_BIN=python
YTDLP_TIMEOUT_MS=25000
# Optional hardening for datacenter hosts (Render/Fly/HF) where YouTube
# challenges server IPs ("Sign in to confirm you're not a bot"):
# YTDLP_COOKIES — paste a fresh YouTube cookies.txt body (Netscape format).
#   Strongest fix for AUDIO_BLOCKED / bot-challenge failures. Keep secret.
# YTDLP_EXTRA_ARGS — extra yt-dlp flags, e.g. "--impersonate chrome".
# YTDLP_USER_AGENT — override the yt-dlp + audio-proxy User-Agent.
# YT_PO_TOKEN / YT_VISITOR_DATA / YT_COOKIE / YT_USER_AGENT — Innertube
#   session hardening (proof-of-origin token, visitor id, login cookie).
#YTDLP_COOKIES=
#YTDLP_EXTRA_ARGS=
#YTDLP_USER_AGENT=
#YT_PO_TOKEN=
#YT_VISITOR_DATA=
#YT_COOKIE=
#YT_USER_AGENT=
